{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5\\ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Model"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    },
    "_meta": {
      "title": "Text encoder"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "LTX-2.5\\ltx-2.5-video-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "Video VAE"
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Cinematic shot, highly detailed, photorealistic, 8k",
      "clip": ["clip", 0]
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, low quality, deformed, artifacts, ugly, text, watermark, bad anatomy, static, jittery",
      "clip": ["clip", 0]
    },
    "_meta": {
      "title": "Negative"
    }
  },
  "cond": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "frame_rate": 24.0,
      "positive": ["pos", 0],
      "negative": ["neg", 0]
    },
    "_meta": {
      "title": "Conditioning"
    }
  },
  "empty": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 544,
      "height": 960,
      "length": 25,
      "batch_size": 1
    },
    "_meta": {
      "title": "Length"
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    },
    "_meta": {
      "title": "Seed"
    }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "cfg": 3.0,
      "model": ["unet", 0],
      "positive": ["cond", 0],
      "negative": ["cond", 1]
    },
    "_meta": {
      "title": "Guider"
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    },
    "_meta": {
      "title": "Sampler select"
    }
  },
  "sigmas": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    },
    "_meta": {
      "title": "Sigmas"
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler", 0],
      "sigmas": ["sigmas", 0],
      "latent_image": ["empty", 0]
    },
    "_meta": {
      "title": "Sample"
    }
  },
  "dec": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 128,
      "temporal_overlap": 32,
      "samples": ["sample", 0],
      "vae": ["vae", 0]
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "save": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["dec", 0],
      "frame_rate": 24.0,
      "loop_count": 0,
      "filename_prefix": "keshiki/video",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    },
    "_meta": {
      "title": "Save"
    }
  }
}
